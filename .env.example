# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Prisma / Postgres) ────────────────────────────────────────
# LOCAL DEV ONLY: run `docker compose up -d`, then use the value below.
# Do NOT paste this into Railway or any other host — "localhost" there means
# the app's own container, where no database is running. On Railway, add a
# Postgres service and set this variable to the reference ${{Postgres.DATABASE_URL}}
# instead (see SETUP.md).
DATABASE_URL="postgresql://agent:agent@localhost:5432/asher_agent?schema=public"

# ── Telegram ─────────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=
# Message @userinfobot (or check bot logs after messaging your bot once) to
# get your numeric chat id. The bot will ONLY respond to this chat id.
TELEGRAM_ALLOWED_CHAT_ID=
# Long-polling (default) needs neither of the two vars below and works from
# any machine, including local dev, with no public URL.
TELEGRAM_USE_WEBHOOK=false
# Only needed if TELEGRAM_USE_WEBHOOK=true:
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# ── AI (Anthropic / Claude) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional overrides — sensible defaults are used if unset.
AI_MODEL_STRATEGY=claude-opus-5
AI_MODEL_FAST=claude-haiku-4-5

# ── Internal HTTP auth ───────────────────────────────────────────────────
# Any long random string. Guards internal/health routes.
ADMIN_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# ── Safety ───────────────────────────────────────────────────────────────
# When true (default), no integration performs a real external action —
# everything that would call a real API instead logs what WOULD happen.
DRY_RUN=true

# Reserved for Phase 2 budget alerts (usage is already tracked in Phase 1,
# enforcement is not implemented yet).
# Hard limit. AI calls are refused once month-to-date spend reaches this,
# with a warning in Telegram at 80%. Set to 0 to disable the limit.
AI_MONTHLY_BUDGET_USD=50

# ── Social publishing ────────────────────────────────────────────────────
# Encrypts stored platform access tokens. Generate with: openssl rand -hex 32
# Required only once you connect an account. Changing it makes already-stored
# tokens undecryptable, so you'd reconnect the account.
SOCIAL_TOKEN_KEY=
# Meta Graph API version used for Instagram publishing. Check the current
# supported version in the Meta developer console before changing.
META_GRAPH_API_VERSION=v21.0

# ── Website (ashersimmonsmusic.com) ──────────────────────────────────────
# Content goes into Sanity, which the Next.js site renders from — no deploy
# needed. Get these from sanity.io/manage; the token needs Editor rights.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=
# Lets the agent file issues on the site repo for work that needs real code.
# A fine-grained token with Issues: write on that repo only.
GITHUB_TOKEN=
WEBSITE_REPO=ashersimmonsmusic/ashersimmonsmusic.com

# ── Analytics ────────────────────────────────────────────────────────────
# Subscriber and sales figures from the website's database. Must be the
# SERVICE ROLE key, not the anon key: newsletter_subscribers is insert-only
# under RLS, so an anon key reads an empty list instead of erroring, and
# would report zero subscribers forever.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
