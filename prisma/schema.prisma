// Phase 1 schema — see ARCHITECTURE.md §4 for rationale and for entities
// deliberately deferred to later phases (Campaign, MusicRelease, Contact,
// Outreach, Opportunity, SocialAccount/SocialPost, PressRelease, EPK, etc.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────

enum UserRole {
  ARTIST
  ADMIN
}

model User {
  id              String   @id @default(cuid())
  telegramChatId  String?  @unique
  email           String?  @unique
  name            String
  role            UserRole @default(ARTIST)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Brand Bible ──────────────────────────────────────────────────────────

model BrandProfile {
  id                 String      @id @default(cuid())
  name               String      @default("Asher Simmons")
  colors             Json        @default("{}")
  visualMotifs       Json        @default("{}")
  voice              Json        @default("{}")
  identityBoundaries Json        @default("{}")
  importedFrom       String?
  rules              BrandRule[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

enum BrandRuleCategory {
  VISUAL
  VOICE
  SAFETY
  BEHAVIOR
}

enum BrandRuleKind {
  FACT
  PREFERENCE
  OPINION
  ONE_TIME_EDIT
  PERMANENT_PREFERENCE
  UNCONFIRMED
}

enum BrandRuleSource {
  BRAND_BOOK_IMPORT
  ASHER_CORRECTION
  MANUAL
  AGENT_PROPOSED
}

model BrandRule {
  id             String            @id @default(cuid())
  brandProfileId String
  brandProfile   BrandProfile      @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  category       BrandRuleCategory
  kind           BrandRuleKind
  description    String
  source         BrandRuleSource
  isActive       Boolean           @default(true)
  relatedRuleId  String?
  relatedRule    BrandRule?        @relation("RuleHistory", fields: [relatedRuleId], references: [id])
  history        BrandRule[]       @relation("RuleHistory")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([brandProfileId, category, isActive])
}

// ── Content Library ──────────────────────────────────────────────────────

enum AssetType {
  PHOTO
  VIDEO
  AUDIO
  MUSIC
  DOCUMENT
  TEXT
  URL
  OTHER
}

enum AssetStatus {
  UNPROCESSED
  PROCESSED
  PUBLISHED
  ARCHIVED
}

model Asset {
  id              String        @id @default(cuid())
  filename        String
  storageKey      String
  mimeType        String?
  assetType       AssetType
  description     String?
  tags            String[]      @default([])
  status          AssetStatus   @default(UNPROCESSED)
  source          String?
  sourceUrl       String?
  rawTextContent  String?
  usageRights     String?
  metadata        Json          @default("{}")
  contentIdeas    ContentIdea[]
  socialPosts     SocialPost[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([assetType, status])
}

// ── Content ideation backlog ─────────────────────────────────────────────

enum ContentIdeaStatus {
  NEW
  DRAFTED
  USED
  DISCARDED
}

model ContentIdea {
  id            String            @id @default(cuid())
  title         String
  description   String?
  pillar        String?
  status        ContentIdeaStatus @default(NEW)
  sourceAssetId String?
  sourceAsset   Asset?            @relation(fields: [sourceAssetId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, pillar])
}

// ── Knowledge base (brief §40) ────────────────────────────────────────────

enum KnowledgeCategory {
  ARTIST_BIO
  MUSIC_CATALOGUE
  BRAND
  PERSONAL_STORY
  ACHIEVEMENTS
  PRESS
  LIVE_HISTORY
  COLLABORATORS
  BUSINESS
  LINKS
  IMPORTANT_FACTS
}

/// How much weight the agent may put on an item. Anything the agent has not
/// had confirmed by Asher stays UNCONFIRMED so it is never asserted as fact.
enum KnowledgeConfidence {
  FACT
  PREFERENCE
  OPINION
  UNCONFIRMED
}

enum KnowledgeSourceType {
  WEBSITE
  ASHER
  DOCUMENT
  MANUAL
}

model KnowledgeItem {
  id           String              @id @default(cuid())
  category     KnowledgeCategory
  title        String
  content      String
  confidence   KnowledgeConfidence @default(UNCONFIRMED)
  sourceType   KnowledgeSourceType
  sourceUrl    String?
  sourceDetail String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([category, isActive])
}

// ── Approvals ─────────────────────────────────────────────────────────────

enum ApprovalType {
  GENERIC
  SOCIAL_POST
  OUTREACH
  KNOWLEDGE_IMPORT
  BEHAVIOR_RULE
  WEBSITE_CONTENT
  NEWSLETTER
}

enum ApprovalLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  EXPIRED
  CANCELLED
}

model Approval {
  id                String         @id @default(cuid())
  type              ApprovalType   @default(GENERIC)
  level             ApprovalLevel  @default(LEVEL_2)
  status            ApprovalStatus @default(PENDING)
  payload           Json
  telegramChatId    String?
  telegramMessageId String?
  requestedAt       DateTime       @default(now())
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, type])
}

// ── Audit log ─────────────────────────────────────────────────────────────

enum AuditActorType {
  AI
  ASHER
  SYSTEM
}

model AuditLog {
  id         String         @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  actorType  AuditActorType
  actorId    String?
  details    Json           @default("{}")
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ── AI conversation memory (short-term, per Telegram chat) ───────────────

enum AIMessageRole {
  user
  assistant
}

model AIConversation {
  id             String        @id @default(cuid())
  telegramChatId String
  role           AIMessageRole
  content        String
  createdAt      DateTime      @default(now())

  @@index([telegramChatId, createdAt])
}

// ── AI usage / cost tracking ──────────────────────────────────────────────

model AIUsageLog {
  id                String   @id @default(cuid())
  provider          String
  model             String
  taskType          String
  promptTokens      Int
  completionTokens  Int
  cacheReadTokens   Int      @default(0)
  cacheWriteTokens  Int      @default(0)
  estimatedCostUsd  Float
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

// ── Social accounts & posting (ARCHITECTURE.md §6) ────────────────────────

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  X
  TIKTOK
  YOUTUBE
}

model SocialAccount {
  id                String         @id @default(cuid())
  platform          SocialPlatform
  /// Instagram Business account id, or Facebook Page id — the platform's own identifier.
  platformAccountId String
  username          String?
  /// AES-256-GCM ciphertext. Never store or log a token in plaintext.
  accessToken       String
  tokenExpiresAt    DateTime?
  isActive          Boolean        @default(true)
  posts             SocialPost[]
  connectedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([platform, platformAccountId])
  @@index([platform, isActive])
}

enum SocialPostStatus {
  DRAFT
  AWAITING_APPROVAL
  /// Approved by Asher, waiting for its scheduled time.
  SCHEDULED
  /// Claimed by the scheduler. Exists so a restart or a second instance can't
  /// pick up the same post and publish it twice.
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model SocialPost {
  id              String           @id @default(cuid())
  socialAccountId String
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  caption         String
  assetId         String?
  asset           Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  status          SocialPostStatus @default(DRAFT)
  /// When this should go out. Null means it was published immediately.
  scheduledFor    DateTime?
  /// The platform's id for the published post, or a dry-run marker.
  platformPostId  String?
  publishedAt     DateTime?
  failureReason   String?
  /// True when this was recorded under DRY_RUN and never actually left the server.
  dryRun          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([status, scheduledFor])
}
